              ]
            },
            "bob": {
              "password": "bob",
              "roles": [
                "Manager"
              ]
            },
            "carol": {
              "password": "carol",
              "roles": [
                "Warehouse"
              ]
            },
            "admin": {
              "password": "admin",
              "roles": [
                "Admin"
              ]
            },
            "dave": {
              "password": "dave",
              "roles": [
                "Requester"
              ]
            }
          }
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        }
      }
    }
