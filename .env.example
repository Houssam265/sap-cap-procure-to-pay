# ==============================================================================
# Fichier d'exemple des variables d'environnement (SAP CAP Procure-to-Pay)
# Copiez ce fichier vers .env et adaptez les valeurs pour votre environnement.
# Ce fichier ne contient AUCUN secret réel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Mode Démo / Développement conteneurisé
# ------------------------------------------------------------------------------
# Par défaut à false (fail-closed) : l'image démarre en production stricte
# (aucun compte mock, /api/switch et /api/login répondent 404).
# Ne basculez à true qu'en local dans docker-compose pour les tests et démonstrations.
PTP_DEMO_MODE=false

# ------------------------------------------------------------------------------
# 2. Secret de signature HMAC du cookie de session (ptp_auth)
# ------------------------------------------------------------------------------
# En production, ce secret doit être une chaîne aléatoire d'au moins 32 caractères.
# Exemple pour générer un secret fort : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PTP_COOKIE_SECRET=change-me-to-a-secure-random-32-char-secret-string

# ------------------------------------------------------------------------------
# 3. Port d'écoute du serveur
# ------------------------------------------------------------------------------
PORT=4004

# ------------------------------------------------------------------------------
# 4. Connexion PostgreSQL (utilisée par @cap-js/postgres)
# ------------------------------------------------------------------------------
POSTGRES_DB=procure_to_pay
POSTGRES_USER=ptp_user
POSTGRES_PASSWORD=change_this_postgres_password_in_production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Configuration CDS pour PostgreSQL
CDS_REQUIRES_DB_KIND=postgres
CDS_REQUIRES_DB_CREDENTIALS_HOST=postgres
CDS_REQUIRES_DB_CREDENTIALS_PORT=5432
CDS_REQUIRES_DB_CREDENTIALS_USER=ptp_user
CDS_REQUIRES_DB_CREDENTIALS_PASSWORD=change_this_postgres_password_in_production
CDS_REQUIRES_DB_CREDENTIALS_DATABASE=procure_to_pay

# Forcer le rechargement des données CSV (false par défaut pour garantir l'idempotence)
PTP_FORCE_SEED=false

# ------------------------------------------------------------------------------
# 5. File d'attente persistante CAP (désactivée par défaut : aucune messagerie asynchrone)
# ------------------------------------------------------------------------------
CDS_REQUIRES_QUEUE=false
